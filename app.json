{
  "expo": {
    "name": "Moni – Sổ chi tiêu cá nhân",
    "slug": "money-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "monomoney",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "package": "com.monomoney.personal",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F7F9F7",
        "foregroundImage": "./assets/brand/foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F9F7",
          "image": "./assets/brand/foreground.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép Moni dùng Face ID để mở sổ tiền của bạn."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "076d740a-8c5d-4885-90a3-228a10233c87"
      }
    }
  }
}
